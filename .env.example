# ---------------------------------------------------------------------------
# ClipForge — variabili d'ambiente
# Copia questo file in `.env` (root) e compila con i tuoi valori reali.
# NON committare mai `.env` con chiavi vere.
# ---------------------------------------------------------------------------

# --- Supabase (Auth + Postgres + Storage) ---------------------------------
# Da: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key: usata solo dal worker (query DB che bypassano la RLS), MAI esposta al
# browser. apps/web non ne ha più bisogno da quando lo storage è passato a R2 (vedi sotto).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Non usata direttamente dall'app (worker e web parlano con Postgres tramite l'API
# Supabase/PostgREST, non una connessione diretta) — utile solo se vuoi eseguire le
# migrazioni in packages/db/migrations con `psql` invece che dal SQL editor di Supabase.
# Da: Supabase Dashboard > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Variante NEXT_PUBLIC_* richiesta dal client Next.js nel browser (solo URL + anon key, mai la service role)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Cloudflare R2 (storage video sorgente + clip renderizzate) -----------
# Il piano Free di Supabase Storage limita ogni file a 50MB (troppo poco per video sorgente),
# quindi lo storage vero e proprio è su R2. Dashboard Cloudflare -> R2 Object Storage.
# Account ID: visibile nella sidebar destra della pagina R2, o nell'URL del dashboard.
R2_ACCOUNT_ID=your-cloudflare-account-id
# R2 -> Manage API Tokens -> Create API Token (permessi "Object Read & Write" sul bucket)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Nome del bucket R2 creato per il progetto
R2_BUCKET=clipforge-media

# --- AI ---------------------------------------------------------------------
# https://console.anthropic.com/
# ANTHROPIC_API_KEY serve sia al worker sia al sito (apps/web) — quest'ultimo la usa SOLO per
# "Rigenera titolo" sulle clip long-form (chiamata leggera, Haiku). Va messa in entrambi i posti:
# apps/worker/.env E apps/web/.env.local in locale, e su Vercel come env var del progetto web.
ANTHROPIC_API_KEY=sk-ant-your-key
# Modello economico per il primo passaggio (candidate detection)
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
# Modello più potente per ranking finale + EDL (Shorts)
ANTHROPIC_MODEL_STRONG=claude-sonnet-5
# Modello per il ranking dei video long-form (VOD Twitch): quella chiamata manda l'intero
# transcript di tutti i candidati insieme, su un VOD lungo sono facilmente 200mila+ token di
# input — separato da ANTHROPIC_MODEL_STRONG apposta, così se quello è su un modello più costoso
# (es. Opus, per la qualità sugli Shorts dove il contesto è piccolo) il long-form non lo eredita.
ANTHROPIC_MODEL_LONGFORM=claude-sonnet-5

# --- Speech-to-text -----------------------------------------------------
# https://platform.openai.com/api-keys — usata solo per Whisper (trascrizione)
OPENAI_API_KEY=sk-your-openai-key

# "openai" (default, a pagamento) oppure "local" (faster-whisper self-hosted sulla tua GPU,
# gratis — vedi apps/worker/whisper-server/README.md per il setup). Con "local" OPENAI_API_KEY
# sopra non viene mai chiamata, ma va comunque valorizzata (anche con un placeholder): lo schema
# di validazione dell'ambiente la richiede sempre, a prescindere dal provider scelto.
TRANSCRIPTION_PROVIDER=openai
# Solo se TRANSCRIPTION_PROVIDER=local: indirizzo del server whisper-server locale.
LOCAL_WHISPER_URL=http://127.0.0.1:8765

# --- Worker ---------------------------------------------------------------
# URL a cui il frontend (Vercel) può opzionalmente notificare/pingare il worker.
# Non obbligatorio in Fase 1 (il worker fa polling autonomo della coda su Postgres).
RENDER_WORKER_URL=http://localhost:8787

# Cartella locale di lavoro temporaneo del worker (download sorgente, file intermedi)
WORKER_TMP_DIR=./tmp

# Intervallo di polling della coda job (ms)
QUEUE_POLL_INTERVAL_MS=3000

# Quanti render di clip in parallelo (CPU-only, non tocca la GPU): alza/abbassa in base ai core disponibili
RENDER_CONCURRENCY=2

# Quanti video in analisi (download+trascrizione+AI) in parallelo: evita che un video bloccato
# in retry automatico blocchi anche gli altri dietro di lui. La trascrizione GPU resta comunque
# serializzata internamente, quindi è sicuro anche con una sola GPU.
VIDEO_CONCURRENCY=2

# Opzionale: alcuni video YouTube (età limitata, "Sign in to confirm your age") falliscono
# SEMPRE senza un account autenticato, anche riprovando. Se impostato, yt-dlp riusa i cookie di
# sessione di un browser già loggato su YouTube su questa macchina (valori tipici: chrome, edge,
# firefox). Su Windows Chrome può fallire con "Failed to decrypt with DPAPI" (bug noto) — in tal
# caso usa YT_DLP_COOKIES_FILE sotto, oppure prova "edge".
# YT_DLP_COOKIES_FROM_BROWSER=edge

# Alternativa più affidabile (bypassa il problema DPAPI sopra): percorso a un file cookies.txt
# esportato manualmente da un'estensione del browser (es. "Get cookies.txt LOCALLY") mentre sei
# loggato su YouTube. Ha precedenza su YT_DLP_COOKIES_FROM_BROWSER se entrambi sono impostati.
# YT_DLP_COOKIES_FILE=./cookies.txt
